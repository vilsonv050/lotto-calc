    // --- БЛОК 9: КЕНО (35 ИЗ 48) ---
    function scanKenoCombos() {
        const comboSize = Math.min(parseInt(document.getElementById('kenoComboSize').value) || 6, 10);
        const minHits = parseInt(document.getElementById('kenoMinHits').value) || 6;
        const btn = document.getElementById("btnKenoScan");
        const box = document.getElementById("resultKeno");

        if (comboSize < 6) { alert("Размер связки от 6 до 10."); return; }
        if (minHits < 6) { alert("Минимум ходов должно быть от 6 до 35."); return; }

        if(!parseFile(() => {
            btn.disabled = true; btn.innerText = "Анализирую Кено (может занять пару секунд)...";
            box.style.display = 'block'; 
            box.innerHTML = `<p>Генерация комбинаций из 35 чисел и подсчет совпадений по архиву...</p>`;

            setTimeout(() => {
                const countsMap = new Map();
                
                globalDraws.forEach(draw => {
                    // Берется 35 уникальных чисел из 48
                    let unique48 = [...new Set(draw)].sort((a,b) => a - b);
                    let keno35 = unique48.slice(0, 35);
                    
                    if (keno35.length < 35) return; 

                    // Генерируем комбинации и считаем
                    const combos = getCombinations(keno35, comboSize);
                    combos.forEach(combo => {
                        const key = combo.join(',');
                        countsMap.set(key, (countsMap.get(key) || 0) + 1);
                    });
                });

                let results = [];
                countsMap.forEach((count, comboStr) => { 
                    if (count >= minHits) results.push({ combo: comboStr, count: count }); 
                });

                // Сортируем по убыванию частоты
                results.sort((a, b) => b.count - a.count);

                let screenHtml = "";
                if (results.length === 0) {
                    screenHtml = `<p class="highlight">Связок, выпадающих ${minHits} и более раз вместе, не найдено.</p>`;
                } else {
                    screenHtml = `<p>Найдено связок: <b>${results.length}</b></p>`;
                    screenHtml += `<div class="note" style="margin-bottom:5px; font-size:13px;">Кликните 3 раза по левой колонке, чтобы выделить комбинации, затем Ctrl+C:</div>`;
                    let numsText = "", countsText = "";
                    
                    results.forEach(r => { numsText += r.combo + "\n"; countsText += "Ходов: " + r.count + "\n"; });
                    
                    screenHtml += `
                        <div class="dup-container">
                            <div class="dup-col-counts">${countsText.trim()}</div>
                            <div class="dup-col-nums">${numsText.trim()}</div>
                        </div>
                    `;
                }

                box.innerHTML = screenHtml;
                btn.disabled = false; 
                btn.innerText = "Найти повторяющиеся связки Кено";

            }, 50);
        })){}
    }

    // --- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ---
    function getCombinations(arr, k) {
        const results = [];
        function combo(start, combo) {
            if (combo.length === k) { results.push([...combo]); return; }
            for (let i = start; i < arr.length; i++) { combo.push(arr[i]); combo(i + 1, combo); combo.pop(); }
        }
        combo(0, []);
        return results;
    }

    function mergeSortedArrays(arrays) {
        let result = []; let indices = new Array(arrays.length).fill(0);
        let totalLen = arrays.reduce((acc, arr) => acc + arr.length, 0);
        while(result.length < totalLen) {
            let minVal = Infinity, minIdx = -1;
            for(let i=0; i<arrays.length; i++) { if(indices[i] < arrays[i].length && arrays[i][indices[i]] < minVal) { minVal = arrays[i][indices[i]]; minIdx = i; } }
            result.push(minVal); indices[minIdx]++;
        }
        return result;
    }
</script>

