<script>
    let globalDraws = []; 
    let globalSums = [];  
    const MAX_BALL = 80;  

    function parseFile(callback) {
        const fileInput = document.getElementById('fileInput');
        if (!fileInput.files.length) { alert("Сначала загрузите файл."); return false; }
        
        const reader = new FileReader();
        reader.onload = function(e) {
            const lines = e.target.result.trim().split('\n');
            globalDraws = [];
            globalSums = []; // ИСПРАВЛЕНО: здесь была ошибка (было globalesums)

            lines.forEach(line => {
                line = line.replace(/{|}/g, '').trim();
                if (!line) return;
                
                const parts = line.split(',');
                let validNums = [];
                let sum = 0;

                parts.forEach(p => {
                    const num = parseInt(p.trim());
                    if (!isNaN(num) && num >= 1 && num <= MAX_BALL) {
                        validNums.push(num);
                        sum += num;
                    }
                });

                if (validNums.length > 0) {
                    globalDraws.push(validNums);
                    globalSums.push(sum);
                }
            });
            callback();
        };
        reader.readAsText(fileInput.files[0]);
        return true;
    }

    // --- ЛОГИКА ГЕНЕРАЦИИ ДЛЯ 6 БЛОКА ---
    function toggleExtraInputs() {
        const mode = document.getElementById('extraMode').value;
        document.getElementById('extraRandNContainer').style.display = mode === 'randN' ? 'block' : 'none';
        document.getElementById('extraManualContainer').style.display = mode === 'manual' ? 'block' : 'none';
    }

    function getExtraNumbersString() {
        const mode = document.getElementById('extraMode').value;
        if (mode === 'none') return "";
        let pool = [1, 2, 3, 4];
        let result = [];
        if (mode === 'rand1') { result.push(pool[Math.floor(Math.random() * pool.length)]); }
        else if (mode === 'randN') {
            let count = parseInt(document.getElementById('extraRandNCount').value) || 1;
            count = Math.max(1, Math.min(4, count)); 
            for (let i = pool.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [pool[i], pool[j]] = [pool[j], pool[i]]; }
            result = pool.slice(0, count).sort((a,b) => a-b);
        } else if (mode === 'manual') {
            let input = document.getElementById('extraManualNums').value;
            let nums = input.split(',').map(s => parseInt(s.trim())).filter(n => !isNaN(n) && n >= 1 && n <= 4);
            result = [...new Set(nums)].sort((a,b) => a-b);
        }
        return result.length > 0 ? "," + result.join(",") : "";
    }

    // --- ЛОГИКА ГЕНЕРАЦИИ ДЛЯ 7 БЛОКА ---
    function toggleExtraInputs24() {
        document.getElementById('extra24F2ManualContainer').style.display = document.getElementById('extra24F2Mode').value === 'manual' ? 'block' : 'none';
        document.getElementById('extra24F3ManualContainer').style.display = document.getElementById('extra24F3Mode').value === 'manual' ? 'block' : 'none';
    }

    function getExtraNumbersString24() {
        let finalString = "";
        const modeF2 = document.getElementById('extra24F2Mode').value;
        if (modeF2 !== 'none') {
            let poolF2 = [1, 2, 3, 4, 5, 6, 7, 8]; let resF2 = [];
            if (modeF2 === 'rand1') { resF2.push(poolF2[Math.floor(Math.random() * poolF2.length)]); }
            else if (modeF2 === 'randN') {
                for (let i = poolF2.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [poolF2[i], poolF2[j]] = [poolF2[j], poolF2[i]]; }
                resF2 = poolF2.slice(0, 2).sort((a,b) => a-b);
            } else if (modeF2 === 'manual') {
                let input = document.getElementById('extra24F2ManualNums').value;
                resF2 = input.split(',').map(s => parseInt(s.trim())).filter(n => !isNaN(n) && n >= 1 && n <= 8);
                resF2 = [...new Set(resF2)].sort((a,b) => a-b).slice(0, 2);
            }
            if (resF2.length > 0) finalString += "," + resF2.join(",");
        }
        const modeF3 = document.getElementById('extra24F3Mode').value;
        if (modeF3 !== 'none') {
            let poolF3 = [1, 2, 3]; let resF3 = [];
            if (modeF3 === 'rand1') { resF3.push(poolF3[Math.floor(Math.random() * poolF3.length)]); }
            else if (modeF3 === 'manual') {
                let input = document.getElementById('extra24F3ManualNums').value;
                let nums = input.split(',').map(s => parseInt(s.trim())).filter(n => !isNaN(n) && n >= 1 && n <= 3);
                if (nums.length > 0) resF3.push(nums[0]);
            }
            if (resF3.length > 0) finalString += "," + resF3.join(",");
        }
        return finalString;
    }

    // --- ЛОГИКА ГЕНЕРАЦИИ ДЛЯ 8 БЛОКА ---
    function toggleExtraInputs8() {
        const is4Nums = document.getElementById('exact8Format').value === '4nums';
        document.getElementById('extra8Container').style.display = is4Nums ? 'block' : 'none';
        toggleExtra8SubInputs();
    }

    function toggleExtra8SubInputs() {
        const mode = document.getElementById('extra8Mode').value;
        document.getElementById('extra8RandNContainer').style.display = mode === 'randN' ? 'block' : 'none';
        document.getElementById('extra8ManualContainer').style.display = mode === 'manual' ? 'block' : 'none';
    }

    function getExtraNumbersString8() {
        const mode = document.getElementById('extra8Mode').value;
        if (mode === 'none') return "";
        
        let pool = Array.from({length: 20}, (_, i) => i + 1); 
        let result = [];

        if (mode === 'rand4') {
            for (let i = pool.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [pool[i], pool[j]] = [pool[j], pool[i]];
            }
            result = pool.slice(0, 4).sort((a,b) => a-b);
        } else if (mode === 'randN') {
            let count = parseInt(document.getElementById('extra8RandNCount').value) || 1;
            count = Math.max(1, Math.min(4, count));
            for (let i = pool.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [pool[i], pool[j]] = [pool[j], pool[i]];
            }
            result = pool.slice(0, count).sort((a,b) => a-b);
        } else if (mode === 'manual') {
            let input = document.getElementById('extra8ManualNums').value;
            let nums = input.split(',').map(s => parseInt(s.trim())).filter(n => !isNaN(n) && n >= 1 && n <= 20);
            result = [...new Set(nums)].sort((a,b) => a-b).slice(0, 4); 
        }
        
        return result.length > 0 ? "," + result.join(",") : "";
    }

    // --- ОБЩИЕ ФУНКЦИИ АНАЛИЗА ---
    function getMaxGapInfo(hits, totalLength) {
        if (hits.length === 0) return null;
        let maxGap = -1, intervals = [];

        let gapBefore = hits[0];
        if (gapBefore > maxGap) { maxGap = gapBefore; intervals = [{ startIdx: 0, endIdx: hits[0] - 1 }]; }
        else if (gapBefore === maxGap && maxGap !== -1) { intervals.push({ startIdx: 0, endIdx: hits[0] - 1 }); }

        for (let i = 1; i < hits.length; i++) {
            let gap = hits[i] - hits[i-1] - 1;
            let sIdx = hits[i-1] + 1, eIdx = hits[i] - 1;
            if (gap > maxGap) { maxGap = gap; intervals = [{ startIdx: sIdx, endIdx: eIdx }]; }
            else if (gap === maxGap) { intervals.push({ startIdx: sIdx, endIdx: eIdx }); }
        }

        let gapAfter = totalLength - 1 - hits[hits.length - 1];
        let sIdxLast = hits[hits.length - 1] + 1, eIdxLast = totalLength - 1;
        if (gapAfter > maxGap) { maxGap = gapAfter; intervals = [{ startIdx: sIdxLast, endIdx: eIdxLast }]; }
        else if (gapAfter === maxGap) { intervals.push({ startIdx: sIdxLast, endIdx: eIdxLast }); }

        if (maxGap === -1) maxGap = 0;
        return { gap: maxGap, intervals: intervals };
    }

    function getIntervalsHtml(info) {
        if (info.gap === 0) return '<p><i>Выпадали без перерывов (или 1 раз).</i></p>';
        let html = `<p class="highlight">Повторений интервала: ${info.intervals.length}</p><ul class="interval-list">`;
        info.intervals.forEach(iv => { html += `<li>между №${iv.startIdx + 1} и №${iv.endIdx + 1}</li>`; });
        html += '</ul>';
        return html;
    }

    function calculateSums() {
        if(!parseFile(() => {
            const targets = document.getElementById('sumsInput').value.split(',').map(s => parseInt(s.trim())).filter(n => !isNaN(n));
            const box = document.getElementById('resultSums');
            if(targets.length === 0) { alert("Введите суммы"); return; }
            const hits = []; globalSums.forEach((sum, idx) => { if(targets.includes(sum)) hits.push(idx); });
            showResult(box, hits, globalSums.length, `Суммы: [${targets.join(', ')}]`);
        })){}
    }

    function calculateNums() {
        if(!parseFile(() => {
            const targets = document.getElementById('numsInput').value.split(',').map(s => parseInt(s.trim())).filter(n => !isNaN(n));
            const box = document.getElementById('resultNums');
            if(targets.length === 0) { alert("Введите числа"); return; }
            const hits = []; globalDraws.forEach((draw, idx) => { if (targets.every(t => draw.includes(t))) hits.push(idx); });
            showResult(box, hits, globalDraws.length, `Числа: [${targets.join(', ')}]`);
        })){}
    }

    function showResult(box, hits, totalLen, title) {
        box.style.display = 'block';
        if (hits.length === 0) { box.innerHTML = `<p class="highlight">${title} не найдены.</p>`; }
        else {
            const info = getMaxGapInfo(hits, totalLen);
            box.innerHTML = `<p>Обработано: <b>${totalLen}</b> | Ищем: <b>${title}</b> | Совпадений: <b>${hits.length}</b></p>
                <p>Макс. интервал: <span class="success">${info.gap} тиражей</span></p>
                <div style="margin-top:10px; padding-top:10px; border-top:1px dashed #ccc;">${getIntervalsHtml(info)}</div>`;
        }
    }

    function autoScanNums() {
        const k = parseInt(document.getElementById('numsComboCount').value);
        if (k < 2 || k > 4) { alert("От 2 до 4."); return; }
        const btn = document.getElementById('btnScanNums'); const box = document.getElementById('resultAutoNums');
        if(!parseFile(() => {
            btn.disabled = true; btn.innerText = "Сканирую..."; box.style.display = 'block'; box.innerHTML = `<p>Перебор, подождите...</p>`;
            setTimeout(() => {
                const uniqueNums = [...new Set(globalDraws.flat())].sort((a,b) => a-b);
                const combos = getCombinations(uniqueNums, k); let bestGap = Infinity, bestResults = [];
                for (let c = 0; c < combos.length; c++) {
                    const combo = combos[c]; const hits = [];
                    for (let i = 0; i < globalDraws.length; i++) { if (combo.every(num => globalDraws[i].includes(num))) hits.push(i); }
                    if (hits.length === 0) continue;
                    const info = getMaxGapInfo(hits, globalDraws.length);
                    if (info.gap < bestGap) { bestGap = info.gap; bestResults = [{ combo, gap: info.gap, intervals: info.intervals }]; }
                    else if (info.gap === bestGap) { bestResults.push({ combo, gap: info.gap, intervals: info.intervals }); if(bestResults.length > 50) break; }
                }
                btn.disabled = false; btn.innerText = "Найти лучшие связки чисел"; renderAutoResults(box, bestResults, 'Числа');
            }, 50);
        })){}
    }

    function autoScanSums() {
        const k = parseInt(document.getElementById('sumsComboCount').value);
        if (k < 2 || k > 3) { alert("От 2 до 3."); return; }
        const btn = document.getElementById('btnScanSums'); const box = document.getElementById('resultAutoSums');
        if(!parseFile(() => {
            btn.disabled = true; btn.innerText = "Сканирую..."; box.style.display = 'block'; box.innerHTML = `<p>Математический перебор...</p>`;
            setTimeout(() => {
                const sumIndicesMap = new Map(); globalSums.forEach((sum, idx) => { if (!sumIndicesMap.has(sum)) sumIndicesMap.set(sum, []); sumIndicesMap.get(sum).push(idx); });
                const uniqueSums = Array.from(sumIndicesMap.keys()).sort((a,b) => a-b);
                const combos = getCombinations(uniqueSums, k); let bestGap = Infinity, bestResults = [];
                for (let c = 0; c < combos.length; c++) {
                    const combo = combos[c]; const indexArrays = combo.map(sum => sumIndicesMap.get(sum));
                    const mergedIndices = mergeSortedArrays(indexArrays); const info = getMaxGapInfo(mergedIndices, globalSums.length);
                    if (info.gap < bestGap) { bestGap = info.gap; bestResults = [{ combo, gap: info.gap, intervals: info.intervals }]; }
                    else if (info.gap === bestGap) { bestResults.push({ combo, gap: info.gap, intervals: info.intervals }); if(bestResults.length > 50) break; }
                }
                btn.disabled = false; btn.innerText = "Найти лучшие комбинации сумм"; renderAutoResults(box, bestResults, 'Суммы');
            }, 50);
        })){}
    }

    function renderAutoResults(box, bestResults, typeName) {
        if (bestResults.length === 0) { box.innerHTML = `<p class="highlight">Ни одна комбинация не найдена.</p>`; }
        else {
            let html = `<p>Найдено с лучшим интервалом: <b>${bestResults.length}</b></p>`;
            const showCount = Math.min(bestResults.length, 10); 
            for(let i=0; i<showCount; i++) {
                const r = bestResults[i];
                html += `<div class="combo-item"><p><b>${typeName}: [${r.combo.join(', ')}]</b></p><p>Макс. интервал: <span class="success">${r.gap} тиражей</span></p><div style="margin-top:5px;">${getIntervalsHtml(r)}</div></div>`;
            }
            if(bestResults.length > 10) html += `<p>...и еще ${bestResults.length - 10} комб.</p>`;
            box.innerHTML = html;
        }
    }

    function scanFrequentCombos() {
        const k = parseInt(document.getElementById('freqComboSize').value);
        const minHits = parseInt(document.getElementById('freqMinHits').value);
        const btn = document.getElementById('btnFreqScan'); const box = document.getElementById('resultFreq');
        if (k < 2 || k > 4) { alert("Размер связки от 2 до 4."); return; }
        if (minHits < 2) { alert("Минимум выпадений должен быть 2 или больше."); return; }
        if(!parseFile(() => {
            btn.disabled = true; btn.innerText = "Анализирую частоту..."; 
            box.style.display = 'block'; box.innerHTML = `<p>Генерация всех возможных комбинаций 1-20 и подсчет...</p>`;
            setTimeout(() => {
                const nums1to20 = Array.from({length: 20}, (_, i) => i + 1);
                const combos = getCombinations(nums1to20, k); const counts = new Map();
                combos.forEach(combo => counts.set(combo.join(','), 0));
                globalDraws.forEach(draw => { combos.forEach(combo => { if (combo.every(num => draw.includes(num))) { const key = combo.join(','); counts.set(key, counts.get(key) + 1); } }); });
                let results = []; counts.forEach((count, comboStr) => { if (count >= minHits) results.push({ combo: comboStr, count: count }); });
                results.sort((a, b) => b.count - a.count); 
                let screenHtml = "";
                if (results.length === 0) { screenHtml = `<p class="highlight">Связок, выпадающих ${minHits} и более раз вместе, не найдено.</p>`; }
                else {
                    screenHtml = `<p>Найдено связок: <b>${results.length}</b></p>`;
                    const showLimit = Math.min(results.length, 200); let screenTextParts = [];
                    for(let i=0; i<showLimit; i++) { screenTextParts.push(results[i].combo); }
                    screenHtml += `<div class="freq-list">${screenTextParts.join('\n')}</div>`;
                    if(results.length > showLimit) { screenHtml += `<p style="text-align:center; margin-top:10px;">...показано первые 200 из ${results.length}.</p>`; }
                }
                box.innerHTML = screenHtml; btn.disabled = false; btn.innerText = "Найти повторяющиеся связки";
            }, 50);
        })){}
    }

    // --- БЛОК 6 ---
    function scanExactDrawMatches() {
        const minHits = parseInt(document.getElementById('exactMinHits').value);
        const btn = document.getElementById('btnExactScan');
        const box = document.getElementById('resultExact');
        if (minHits < 2) { alert("Минимум повторов должно быть 2 или больше."); return; }
        if(!parseFile(() => {
            btn.disabled = true; btn.innerText = "Ищу дубликаты и генерирую...";
            box.style.display = 'block'; box.innerHTML = `<p>Проверяю все строки на точные совпадения 8 чисел...</p>`;
            setTimeout(() => {
                const mapCounts = new Map();
                globalDraws.forEach(draw => {
                    const sortedDraw = [...draw].sort((a, b) => a - b);
                    const key = sortedDraw.join(','); 
                    mapCounts.set(key, (mapCounts.get(key) || 0) + 1);
                });
                let results = [];
                mapCounts.forEach((count, comboStr) => { if (count >= minHits) results.push({ combo: comboStr, count: count }); });
                results.sort((a, b) => b.count - a.count);
                let screenHtml = "";
                if (results.length === 0) { screenHtml = `<p class="highlight">Тиражей, выпадающих ${minHits} и более раз в точности с одинаковыми числами, не найдено.</p>`; }
                else {
                    screenHtml = `<p>Найдено комбинаций: <b>${results.length}</b></p>`;
                    screenHtml += `<div class="note" style="margin-bottom:5px; font-size:13px;">Кликните 3 раза по левой колонке, чтобы выделить ставки, затем Ctrl+C:</div>`;
                    let numsText = "", countsText = "";
                    results.forEach(r => { numsText += r.combo + getExtraNumbersString() + "\n"; countsText += "Выпало " + r.count + " раз\n"; });
                    screenHtml += `<div class="dup-container"><div class="dup-col-nums">${numsText.trim()}</div><div class="dup-col-counts">${countsText.trim()}</div></div>`;
                }
                box.innerHTML = screenHtml; btn.disabled = false; btn.innerText = "Найти и сгенерировать ставки";
            }, 50);
        })){}
    }

